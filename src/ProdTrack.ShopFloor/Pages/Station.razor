@page "/station/{Code}"
@implements IDisposable
@inject ProdTrackApiClient Api
@inject LiveUpdates Live
@inject StationPreference Preference

<PageTitle>@Code · Shop floor</PageTitle>

<div class="d-flex align-items-center gap-2 mb-2">
    <h1 class="me-auto mb-0">@Code <span class="fs-5 text-muted">@queue?.StationName</span></h1>
    <span class="badge @(Live.IsConnected ? "text-bg-success" : "text-bg-secondary")" data-testid="floor-live">@(Live.IsConnected ? "● Live" : "Offline")</span>
    <button class="btn btn-outline-secondary" @onclick="LoadAsync">Refresh</button>
    <a class="btn btn-outline-secondary" href="./">Change station</a>
</div>

<ScanBox StationCode="@Code" />

@if (error is not null)
{
    <div class="alert alert-warning fs-5 mt-3" role="alert" data-testid="floor-error">@error.Title</div>
}
else if (queue is null)
{
    <p class="mt-3">Loading...</p>
}
else if (queue.Items.Count == 0)
{
    <p class="fs-4 text-muted mt-4" data-testid="queue-empty">No work waiting at @Code.</p>
}
else
{
    <div class="list-group mt-3" data-testid="station-queue">
        @foreach (var item in queue.Items)
        {
            <a class="list-group-item list-group-item-action queue-item py-3" href="operations/@item.OperationId" data-testid="queue-item-@item.WorkOrderNumber">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-3 fw-bold">@item.WorkOrderNumber</div>
                    <StatusBadge Status="@item.Status" />
                    @if (item.WorkOrderStatus == "OnHold")
                    {
                        <span class="badge text-bg-warning">On hold @item.HoldReason</span>
                    }
                    <div class="ms-auto text-end">
                        <div class="fs-4">@item.Quantity pcs</div>
                        <div class="small @(item.IsLate ? "text-danger fw-bold" : "text-muted")">Due @item.DueDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) · P@item.Priority</div>
                    </div>
                </div>
                <div class="text-muted">Step @item.Sequence · @item.ProductSku · @item.ProductName</div>
            </a>
        }
    </div>
}

@code {
    [Parameter]
    public string Code { get; set; } = string.Empty;

    private StationQueueDto? queue;
    private ApiError? error;

    protected override async Task OnParametersSetAsync()
    {
        Code = Code.ToUpperInvariant();
        await Preference.SetAsync(Code);
        await LoadAsync();
        Live.Changed -= OnChangedAsync;
        Live.Changed += OnChangedAsync;
        await Live.WatchStationAsync(Code);
        StateHasChanged();
    }

    private async Task OnChangedAsync()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadAsync()
    {
        var result = await Api.GetStationQueueAsync(Code);
        queue = result.Value ?? queue;
        error = result.Error;
    }

    public void Dispose() => Live.Changed -= OnChangedAsync;
}
