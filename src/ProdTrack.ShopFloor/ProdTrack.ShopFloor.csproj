<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Shop-floor PWA (Blazor WebAssembly), served by ProdTrack.Server under /floor (same-origin cookie session). -->
  <PropertyGroup>
    <StaticWebAssetBasePath>floor</StaticWebAssetBasePath>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- The WASM hot-reload agent (Debug only) registers a lib.module.js that the Server's Blazor pages would also try
         to load as a library initializer; outside Development it is not served and breaks interactivity. -->
    <WasmEnableHotReload>false</WasmEnableHotReload>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProdTrack.ApiClient\ProdTrack.ApiClient.csproj" />
    <ProjectReference Include="..\ProdTrack.UI.Shared\ProdTrack.UI.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>
</Project>
