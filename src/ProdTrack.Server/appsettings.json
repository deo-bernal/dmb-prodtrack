{
  "Cloud": {
    "Provider": "Local"
  },
  "Auth": {
    "Mode": "Identity",
    "BootstrapAdmin": {
      "Email": "",
      "Password": ""
    }
  },
  "ConnectionStrings": {
    "ProdTrack": ""
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedDemoData": false
  },
  "Storage": {
    "Local": {
      "RootPath": "App_Data/files"
    }
  },
  "Plant": {
    "TimeZone": "Asia/Manila"
  },
  "LogFile": {
    "Enabled": true,
    "Path": "App_Data/logs/prodtrack-.json"
  },
  "Telemetry": {
    "Exporter": "None"
  },
  "App": {
    "PublicBaseUrl": "",
    "UseForwardedHeaders": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
