@page "/routings/{ProductTypeName}/edit"
@attribute [Authorize(Policy = Policies.ManageProductsAndRoutings)]
@rendermode InteractiveServer
@using ProdTrack.Application.Routings
@using ProdTrack.Application.Routings.CreateRoutingVersion
@using ProdTrack.Application.Routings.GetRoutings
@using ProdTrack.Application.Stations
@using ProdTrack.Application.Stations.GetStations
@using ProdTrack.Domain.Products
@inject UseCaseDispatcher Dispatcher
@inject NavigationManager Navigation

<PageTitle>Routing editor · ProdTrack</PageTitle>
<h1>Routing editor · @ProductTypeName</h1>
<p class="text-muted">Saving creates a <strong>new version</strong> and makes it current. Work orders already released keep the version they were released with; drafts pick up the new version at release.</p>

<ErrorAlert Error="error" />

@if (type is not null)
{
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label" for="r-name">Routing name</label>
            <input id="r-name" class="form-control" @bind="name" data-testid="routing-name" />
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <span class="text-muted">@(currentVersion is null ? "No current routing yet." : $"Based on current v{currentVersion}.")</span>
        </div>
    </div>

    <table class="table table-sm align-middle" data-testid="routing-steps">
        <thead><tr><th>#</th><th style="width:35%">Station</th><th>Setup (min)</th><th>Std min/unit</th><th>Allow overlap</th><th></th></tr></thead>
        <tbody>
            @for (var i = 0; i < steps.Count; i++)
            {
                var index = i;
                var step = steps[index];
                <tr>
                    <td>@((index + 1) * 10)</td>
                    <td>
                        <select class="form-select form-select-sm" @bind="step.StationCode" aria-label="Station">
                            <option value="">(select)</option>
                            @foreach (var s in stations)
                            {
                                <option value="@s.Code">@s.Code · @s.Name (@s.Type)</option>
                            }
                        </select>
                    </td>
                    <td><input type="number" step="0.1" min="0" class="form-control form-control-sm" @bind="step.SetupMinutes" aria-label="Setup minutes" /></td>
                    <td><input type="number" step="0.01" min="0" class="form-control form-control-sm" @bind="step.StdMinutesPerUnit" aria-label="Standard minutes per unit" /></td>
                    <td><input type="checkbox" class="form-check-input" @bind="step.AllowOverlap" aria-label="Allow overlap with previous step" /></td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(index == 0)" @onclick="() => Move(index, -1)" aria-label="Move up">↑</button>
                        <button class="btn btn-sm btn-outline-secondary" disabled="@(index == steps.Count - 1)" @onclick="() => Move(index, 1)" aria-label="Move down">↓</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => steps.RemoveAt(index)" aria-label="Remove step">✕</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <button class="btn btn-outline-secondary btn-sm" @onclick="() => steps.Add(new StepForm())" data-testid="routing-add-step">Add step</button>
    <p class="text-muted small mt-2">Sequences are renumbered 10, 20, 30... in the order shown. "Allow overlap" lets a step start while the previous step is still running.</p>

    <div class="mt-3">
        <button class="btn btn-primary" @onclick="SaveAsync" data-testid="routing-save">Save as new version</button>
        <a class="btn btn-link" href="routings">Cancel</a>
    </div>
}

@code {
    [Parameter]
    public string ProductTypeName { get; set; } = string.Empty;

    private ProductType? type;
    private IReadOnlyList<StationModel> stations = [];
    private readonly List<StepForm> steps = [];
    private string? name;
    private int? currentVersion;
    private Error? error;

    protected override async Task OnParametersSetAsync()
    {
        if (!Enum.TryParse<ProductType>(ProductTypeName, ignoreCase: true, out var parsed))
        {
            error = Error.NotFound("ProductType.NotFound", $"Unknown product type '{ProductTypeName}'.");
            return;
        }

        type = parsed;
        var st = await Dispatcher.QueryAsync(new GetStationsQuery());
        if (st.IsSuccess)
        {
            stations = st.Value;
        }

        var result = await Dispatcher.QueryAsync(new GetRoutingsQuery(parsed, CurrentOnly: true));
        error = result.Error;
        var current = result.IsSuccess ? result.Value.FirstOrDefault() : null;
        steps.Clear();
        if (current is not null)
        {
            currentVersion = current.Version;
            name = current.Name;
            steps.AddRange(current.Steps.OrderBy(s => s.Sequence).Select(s => new StepForm
            {
                StationCode = s.StationCode,
                SetupMinutes = s.SetupMinutes,
                StdMinutesPerUnit = s.StdMinutesPerUnit,
                AllowOverlap = s.AllowOverlap,
            }));
        }
        else
        {
            name = $"{parsed} routing";
        }
    }

    private void Move(int index, int delta)
    {
        var target = index + delta;
        (steps[index], steps[target]) = (steps[target], steps[index]);
    }

    private async Task SaveAsync()
    {
        var inputs = steps.Select((s, i) => new RoutingStepInput((i + 1) * 10, s.StationCode, s.SetupMinutes, s.StdMinutesPerUnit, s.AllowOverlap)).ToList();
        var result = await Dispatcher.SendAsync(new CreateRoutingVersionCommand(type!.Value, name ?? string.Empty, inputs));
        error = result.Error;
        if (result.IsSuccess)
        {
            Navigation.NavigateTo("routings");
        }
    }

    private sealed class StepForm
    {
        public string StationCode { get; set; } = string.Empty;

        public decimal SetupMinutes { get; set; }

        public decimal StdMinutesPerUnit { get; set; }

        public bool AllowOverlap { get; set; }
    }
}
