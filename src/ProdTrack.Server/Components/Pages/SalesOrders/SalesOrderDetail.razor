@page "/sales-orders/{Id:int}"
@attribute [Authorize(Policy = Policies.ReadAll)]
@rendermode InteractiveServer
@using ProdTrack.Application.SalesOrders
@using ProdTrack.Domain.SalesOrders
@inject UseCaseDispatcher Dispatcher

<PageTitle>@(so?.Number ?? "Sales order") · ProdTrack</PageTitle>

<ErrorAlert Error="error" />
@if (notice is not null)
{
    <div class="alert alert-success" role="status" data-testid="so-notice">@notice</div>
}

@if (so is not null)
{
    <div class="d-flex align-items-center mb-3 gap-2">
        <h1 class="me-auto">@so.Number <StatusBadge Status="@so.Status.ToString()" /></h1>
        @if (so.Status == SalesOrderStatus.Open)
        {
            <AuthorizeView Policy="@Policies.PlanWorkOrders">
                <a class="btn btn-outline-primary" href="sales-orders/@so.Id/edit" data-testid="so-edit">Edit</a>
                <button class="btn btn-outline-danger" @onclick="CancelAsync" data-testid="so-cancel">Cancel order</button>
            </AuthorizeView>
        }
    </div>

    <dl class="row">
        <dt class="col-sm-2">Customer</dt><dd class="col-sm-10">@so.CustomerName</dd>
        <dt class="col-sm-2">Customer PO</dt><dd class="col-sm-10">@(so.PoNumber ?? "-")</dd>
        <dt class="col-sm-2">Due</dt><dd class="col-sm-10">@so.DueDate.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</dd>
        <dt class="col-sm-2">Created</dt><dd class="col-sm-10">@so.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture)</dd>
    </dl>

    <h2 class="h4">Lines</h2>
    <table class="table table-sm" data-testid="so-lines-table">
        <thead><tr><th>#</th><th>Product</th><th class="text-end">Qty</th><th>Legend</th><th>Work order</th></tr></thead>
        <tbody>
            @foreach (var l in so.Lines)
            {
                <tr>
                    <td>@l.LineNumber</td>
                    <td>@l.ProductSku · @l.ProductName</td>
                    <td class="text-end">@l.Quantity</td>
                    <td>@l.Legend</td>
                    <td>
                        @if (l.WorkOrderId is not null)
                        {
                            <a href="work-orders/@l.WorkOrderId">@l.WorkOrderNumber</a> <StatusBadge Status="@(l.WorkOrderStatus ?? string.Empty)" />
                        }
                        else
                        {
                            <span class="text-muted">None yet</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (so.Status == SalesOrderStatus.Open && so.Lines.Any(l => l.WorkOrderId is null))
    {
        <AuthorizeView Policy="@Policies.PlanWorkOrders">
            <div class="row g-2 align-items-end">
                <div class="col-auto">
                    <label class="form-label" for="wo-priority">Priority (1 = highest)</label>
                    <input id="wo-priority" type="number" min="1" max="5" class="form-control" @bind="priority" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-success" @onclick="GenerateAsync" data-testid="so-create-work-orders">Create work orders for open lines</button>
                </div>
            </div>
            <p class="text-muted small mt-2">Each line without a work order gets a Draft work order with the line's product, quantity, legend and spec; the sales order due date and customer are copied.</p>
        </AuthorizeView>
    }
}

@code {
    [Parameter]
    public int Id { get; set; }

    private SalesOrderDetailModel? so;
    private Error? error;
    private string? notice;
    private int priority = 3;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Dispatcher.QueryAsync(new GetSalesOrderQuery(Id));
        (so, error) = result.IsSuccess ? (result.Value, null) : (so, result.Error);
    }

    private async Task GenerateAsync()
    {
        notice = null;
        var result = await Dispatcher.SendAsync(new CreateWorkOrdersFromSalesOrderCommand(Id, priority));
        error = result.Error;
        if (result.IsSuccess)
        {
            notice = $"Created {result.Value.Created.Count} work order(s): {string.Join(", ", result.Value.Created.Select(c => c.WorkOrderNumber))}.";
            await LoadAsync();
        }
    }

    private async Task CancelAsync()
    {
        notice = null;
        var result = await Dispatcher.SendAsync(new CancelSalesOrderCommand(Id, so?.Version));
        error = result.Error;
        if (result.IsSuccess)
        {
            notice = "Sales order cancelled.";
            await LoadAsync();
        }
    }
}
