@page "/routings"
@attribute [Authorize(Policy = Policies.ReadAll)]
@rendermode InteractiveServer
@using ProdTrack.Application.Routings
@using ProdTrack.Application.Routings.GetRoutings
@inject UseCaseDispatcher Dispatcher

<PageTitle>Routings · ProdTrack</PageTitle>
<h1>Routings</h1>
<p class="text-muted">Current routing per product type. New versions are created through the API (<code>POST /api/v1/routings</code>); released work orders keep the version they were released with.</p>

<ErrorAlert Error="error" />
@foreach (var r in routings)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>@r.ProductType</strong> · v@r.Version · @r.Name
            @if (r.IsCurrent)
            {
                <span class="badge text-bg-success ms-2">Current</span>
            }
        </div>
        <table class="table table-sm mb-0">
            <thead><tr><th>#</th><th>Station</th><th class="text-end">Setup (min)</th><th class="text-end">Std min/unit</th><th>Overlap</th></tr></thead>
            <tbody>
                @foreach (var s in r.Steps)
                {
                    <tr><td>@s.Sequence</td><td>@s.StationCode · @s.StationName</td><td class="text-end">@s.SetupMinutes</td><td class="text-end">@s.StdMinutesPerUnit</td><td>@(s.AllowOverlap ? "Yes" : "No")</td></tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private IReadOnlyList<RoutingModel> routings = [];
    private Error? error;

    protected override async Task OnInitializedAsync()
    {
        var result = await Dispatcher.QueryAsync(new GetRoutingsQuery(CurrentOnly: true));
        if (result.IsSuccess)
        {
            routings = result.Value;
        }

        error = result.Error;
    }
}
