#!/usr/bin/env bash
# Rejects direct pushes to main (branch protection is not available for private repos on GitHub Free).
# Enable once per clone: git config core.hooksPath .githooks
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "Direct push to main is not allowed - open a pull request (docs/11 section 7.1)." >&2
    exit 1
  fi
done
exit 0
